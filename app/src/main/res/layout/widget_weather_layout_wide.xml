<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="3dp">

    <!-- Left Block: Concello (top), Temperatura + UV debaixo, e Condición (bottom) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Concello -->
        <TextView
            android:id="@+id/widget_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Galicia"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:lines="1"
            android:ellipsize="end" />

        <!-- Row with (Temp + UV underneath) and (Emoji + Condition) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Column: Temperature on top, UV underneath -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:lines="1" />

                <TextView
                    android:id="@+id/widget_uv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-1dp"
                    android:text="☀️ UV 3"
                    android:textColor="#FEF08A"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:lines="1"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Column: Emoji & Condition -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛅"
                    android:textSize="18sp"
                    android:singleLine="true"
                    android:lines="1" />

                <TextView
                    android:id="@+id/widget_condition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando..."
                    android:textColor="#BAE6FD"
                    android:textSize="10sp"
                    android:singleLine="true"
                    android:lines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider between Left and Center -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="28dp"
        android:layout_marginHorizontal="5dp"
        android:background="@drawable/bg_widget_divider"
        android:contentDescription="@null" />

    <!-- Center Block: Fixed 3 Metrics (Icon on top, value underneath) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Column 1: Vento -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💨"
                android:textSize="12sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="-- km/h"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 2: Humidade -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧"
                android:textSize="12sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--%"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 3: Precipitación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌧️"
                android:textSize="12sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="-- mm"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Block: Updated time on top of Refresh Button -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="14:30"
            android:textColor="#BAE6FD"
            android:textSize="9sp"
            android:singleLine="true"
            android:lines="1"
            android:gravity="center" />

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/ic_widget_refresh"
            android:padding="4dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:id="@+id/widget_location_arrows_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/widget_btn_prev_location"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/bg_widget_button"
                android:contentDescription="Localización anterior"
                android:src="@drawable/ic_widget_arrow_left"
                android:padding="2dp"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/widget_btn_next_location"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="1dp"
                android:background="@drawable/bg_widget_button"
                android:contentDescription="Localización seguinte"
                android:src="@drawable/ic_widget_arrow_right"
                android:padding="2dp"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
