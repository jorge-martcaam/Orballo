<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:paddingHorizontal="9dp"
    android:paddingVertical="7dp">

    <!-- Row 1: Full-width Location (no truncation caused by right-aligned buttons) -->
    <TextView
        android:id="@+id/widget_location"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Galicia"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:lines="1"
        android:ellipsize="end" />

    <!-- Hidden compatibility view for updated time -->
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Row 2: Action buttons in horizontal (Refresh + Prev/Next Arrows) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/bg_widget_button"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/ic_widget_refresh"
            android:padding="3.5dp"
            android:scaleType="centerInside" />

        <LinearLayout
            android:id="@+id/widget_location_arrows_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/widget_btn_prev_location"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_widget_button"
                android:contentDescription="Localización anterior"
                android:src="@drawable/ic_widget_arrow_left"
                android:padding="2.5dp"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/widget_btn_next_location"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_widget_button"
                android:contentDescription="Localización seguinte"
                android:src="@drawable/ic_widget_arrow_right"
                android:padding="2.5dp"
                android:scaleType="centerInside" />
        </LinearLayout>
    </LinearLayout>

    <!-- Row 3: Temperature (with UV underneath), Condition/Sensación, & Emoji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Column: Temperature on top, UV underneath -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--°"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_uv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1dp"
                android:text="☀️ UV 3"
                android:textColor="#FEF08A"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Column: Condition & Sensación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_feels_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Sens. --°"
                android:textColor="#E0F2FE"
                android:textSize="10.5sp"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:text="⛅"
            android:textSize="30sp"
            android:singleLine="true"
            android:lines="1" />
    </LinearLayout>

    <!-- Row 4: Relevant Metrics (Vento, Humidade, Chuvia) for 2x2 and taller widgets -->
    <LinearLayout
        android:id="@+id/widget_compact_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="5dp">

        <!-- Column 1: Vento -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_label_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💨"
                android:textSize="11sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="-- km/h"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 2: Humidade -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_label_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💧"
                android:textSize="11sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="--%"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 3: Precipitación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_label_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌧️"
                android:textSize="11sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="-- mm"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1"
                android:ellipsize="none" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3-Column Compact Periods Forecast (Mañá, Tarde, Noite) -->
    <LinearLayout
        android:id="@+id/widget_periods_compact_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="5dp"
        android:visibility="gone">

        <!-- Column 1: Period 1 (e.g. Mañá) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_cperiod1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mañá"
                android:textColor="#BAE6FD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod1_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="⛅ 15°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod1_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="💧 60%"
                android:textColor="#E0F2FE"
                android:textSize="9sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod1_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="💨 15"
                android:textColor="#BAE6FD"
                android:textSize="9sp"
                android:singleLine="true"
                android:lines="1" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 2: Period 2 (e.g. Tarde) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_cperiod2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tarde"
                android:textColor="#BAE6FD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod2_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="⛅ 18°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod2_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="💧 55%"
                android:textColor="#E0F2FE"
                android:textSize="9sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod2_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="💨 18"
                android:textColor="#BAE6FD"
                android:textSize="9sp"
                android:singleLine="true"
                android:lines="1" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="2dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 3: Period 3 (e.g. Noite) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_cperiod3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Noite"
                android:textColor="#BAE6FD"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod3_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="🌙 14°"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod3_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="💧 20%"
                android:textColor="#E0F2FE"
                android:textSize="9sp"
                android:singleLine="true"
                android:lines="1" />

            <TextView
                android:id="@+id/widget_cperiod3_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="💨 12"
                android:textColor="#BAE6FD"
                android:textSize="9sp"
                android:singleLine="true"
                android:lines="1" />
        </LinearLayout>

        <!-- Hidden legacy compatibility view -->
        <TextView
            android:id="@+id/widget_periods_compact_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Optional Compact Alert Banner -->
    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_alert_badge"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="⚠️ Aviso"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:lines="1"
        android:ellipsize="end"
        android:visibility="gone" />

</LinearLayout>
