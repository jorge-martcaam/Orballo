<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Header: Location, Subtitle & Accessible 48dp Refresh Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/widget_btn_refresh"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Galicia"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="En tempo real • Actualizado"
                android:textColor="#E0F2FE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/widget_btn_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_widget_button"
                android:contentDescription="@string/widget_refresh"
                android:src="@drawable/ic_widget_refresh"
                android:padding="6dp"
                android:scaleType="centerInside" />

            <LinearLayout
                android:id="@+id/widget_location_arrows_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/widget_btn_prev_location"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_widget_button"
                    android:contentDescription="Localización anterior"
                    android:src="@drawable/ic_widget_arrow_left"
                    android:padding="4dp"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/widget_btn_next_location"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_widget_button"
                    android:contentDescription="Localización seguinte"
                    android:src="@drawable/ic_widget_arrow_right"
                    android:padding="4dp"
                    android:scaleType="centerInside" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Severe Alert Banner (Hidden when none) -->
    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_alert_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="⚠️ Aviso meteorolóxico"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Central Section: Temperature, Condition, Sensación & Emoji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°"
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cargando..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_feels_like"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Sensación --°"
                android:textColor="#E0F2FE"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⛅"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/widget_uv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_widget_button"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="☀️ 3"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Horizontal Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#33FFFFFF"
        android:contentDescription="@null" />

    <!-- Compact Horizontal Metrics Row (Vento, Humidade, Precipitación) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Column 1: Vento -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vento"
                android:textColor="#BAE6FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="-- km/h"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 2: Humidade -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Humidade"
                android:textColor="#BAE6FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="--%"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_widget_divider"
            android:contentDescription="@null" />

        <!-- Column 3: Precipitación -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_label_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precipitación"
                android:textColor="#BAE6FD"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_precip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="-- mm"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
