<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle soft shadow beneath droplet for tactile elevation on light background -->
    <path
        android:fillColor="#1A0284C7"
        android:pathData="M 54,28.5 C 53.5,30 46.5,43 41.5,52.5 C 38,59 35.8,65 35.8,70.5 C 35.8,80.6 43.9,88.7 54,88.7 C 64.1,88.7 72.2,80.6 72.2,70.5 C 72.2,65 70,59 66.5,52.5 C 61.5,43 54.5,30 54,28.5 Z" />

    <!-- Group with teardrop silhouette clip mask -->
    <group>
        <clip-path
            android:pathData="M 54,27 C 53.5,28.5 46.5,41.5 41.5,51 C 38,57.5 36,63.5 36,69 C 36,78.9 44.1,87 54,87 C 63.9,87 72,78.9 72,69 C 72,63.5 70,57.5 66.5,51 C 61.5,41.5 54.5,28.5 54,27 Z" />

        <!-- 1. Top Base / Sky Ocean: rich blue gradient -->
        <path
            android:pathData="M 30,20 L 78,20 L 78,92 L 30,92 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="54"
                    android:startY="27"
                    android:endX="54"
                    android:endY="60"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#0284C7" />
                    <item android:offset="1.0" android:color="#0369A1" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 2. Upper Wave Layer: light cerulean aqua wave -->
        <path
            android:pathData="M 30,55 C 38,58 45,63 53,60 C 60,57 66,54 78,61 L 78,92 L 30,92 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="34"
                    android:startY="55"
                    android:endX="74"
                    android:endY="65"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#BAE6FD" />
                    <item android:offset="0.5" android:color="#7DD3FC" />
                    <item android:offset="1.0" android:color="#A5F3FC" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 3. Middle Wave Layer: vibrant ocean wave -->
        <path
            android:pathData="M 30,64 C 39,63 47,68 55,66 C 62,64 68,62 78,68 L 78,92 L 30,92 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="34"
                    android:startY="63"
                    android:endX="74"
                    android:endY="75"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#38BDF8" />
                    <item android:offset="1.0" android:color="#0284C7" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 4. Bottom Wave Layer: deep ocean blue -->
        <path
            android:pathData="M 30,73 C 40,71 49,78 58,75 C 65,72 71,74 78,76 L 78,92 L 30,92 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="36"
                    android:startY="72"
                    android:endX="65"
                    android:endY="87"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#1D4ED8" />
                    <item android:offset="1.0" android:color="#1E3A8A" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- 5. Deepest Bottom Base Curve: subtle shadow crest -->
        <path
            android:fillColor="#1E293B"
            android:fillAlpha="0.25"
            android:pathData="M 34,80 C 44,78 52,83 62,81 C 67,80 71,81 74,83 L 74,92 L 34,92 Z" />

    </group>

</vector>
